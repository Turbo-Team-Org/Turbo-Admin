# Turbo Admin — copia este archivo a `.env` en la raíz del proyecto
# (mismo directorio que pubspec.yaml). Las claves las consume `core` (Env).

ENVIRONMENT=staging
DATABASE_PROVIDER=supabase
USE_EDGE_GATEWAY=false

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_EDGE_BASE_URL=

# Firebase (Admin sigue inicializando Firebase para Auth / Maps según tu setup)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
